            private bool isInitialized = false;

            // Класс для создания Billboard объектов, которые всегда поворачиваются к камере
            private class Billboard : MonoBehaviour
            {
                  private Camera mainCamera;

                  void Start()
                  {
                        mainCamera = Camera.main;
                        if (mainCamera == null)
                        {
                              mainCamera = FindObjectOfType<Camera>();
                        }
                  }

                  void Update()
                  {
                        if (mainCamera != null)
                        {
                              transform.LookAt(transform.position + mainCamera.transform.rotation * Vector3.forward,
                                              mainCamera.transform.rotation * Vector3.up);
                        }
                  }
            }

            // Метод для отображения сообщений пользователю
            private void ShowMessage(string message, float duration = 3f)
            {
                  Debug.Log($"Showing message: {message}");

                  // Create message panel if it doesn't exist
                  if (messagePanel == null)
                  {
                        CreateMessagePanel();
                  }

                  // Update the message text
                  Text messageText = messagePanel.GetComponentInChildren<Text>();
                  if (messageText != null)
                  {
                        messageText.text = message;
                  }

                  // Show the panel
                  messagePanel.SetActive(true);

                  // Hide after delay
                  if (messageCoroutine != null)
                  {
                        StopCoroutine(messageCoroutine);
                  }

                  messageCoroutine = StartCoroutine(HideMessageAfterDelay(duration));
            }

            // Создание панели сообщений
            private void CreateMessagePanel()
            {
                  // Create a new UI panel for messages
                  messagePanel = new GameObject("MessagePanel");

                  // Find canvas or create one
                  Canvas canvas = FindObjectOfType<Canvas>();
                  if (canvas == null)
                  {
                        GameObject canvasObj = new GameObject("Canvas");
                        canvas = canvasObj.AddComponent<Canvas>();
                        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
                        canvasObj.AddComponent<CanvasScaler>();
                        canvasObj.AddComponent<GraphicRaycaster>();
                  }

                  messagePanel.transform.SetParent(canvas.transform, false);

                  // Add panel components
                  RectTransform rectTransform = messagePanel.AddComponent<RectTransform>();
                  Image panelImage = messagePanel.AddComponent<Image>();
                  panelImage.color = new Color(0.1f, 0.1f, 0.1f, 0.8f);

                  // Configure panel layout
                  rectTransform.anchorMin = new Vector2(0.3f, 0.05f);
                  rectTransform.anchorMax = new Vector2(0.7f, 0.15f);
                  rectTransform.offsetMin = Vector2.zero;
                  rectTransform.offsetMax = Vector2.zero;

                  // Add text to the panel
                  GameObject textObj = new GameObject("MessageText");
                  textObj.transform.SetParent(messagePanel.transform, false);

                  Text text = textObj.AddComponent<Text>();
                  text.text = "";
                  text.fontSize = 24;
                  text.alignment = TextAnchor.MiddleCenter;
                  text.color = Color.white;

                  // Find a font
                  Font font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
                  if (font == null)
                  {
                        Font[] fonts = Resources.FindObjectsOfTypeAll<Font>();
                        if (fonts.Length > 0)
                        {
                              font = fonts[0];
                        }
                  }
                  text.font = font;

                  // Configure text layout
                  RectTransform textRect = text.rectTransform;
                  textRect.anchorMin = new Vector2(0.05f, 0.05f);
                  textRect.anchorMax = new Vector2(0.95f, 0.95f);
                  textRect.offsetMin = Vector2.zero;
                  textRect.offsetMax = Vector2.zero;

                  // Initially hide the panel
                  messagePanel.SetActive(false);
            }

            // Корутина для скрытия сообщения
            private IEnumerator HideMessageAfterDelay(float delay)
            {
                  yield return new WaitForSeconds(delay);

                  if (messagePanel != null)
                  {
                        messagePanel.SetActive(false);
                  }
            }

            // Метод для показа большого сообщения на весь экран
            private void ShowBigScreenMessage(string message, float duration = 5.0f)
            {
                  // Create a new GameObject for the full-screen message
                  GameObject msgObj = new GameObject("BigScreenMessage");

                  // Find canvas or create one
                  Canvas canvas = FindObjectOfType<Canvas>();
                  Debug.Log("Creating EventSystem");
                  GameObject eventSystem = new GameObject("EventSystem");
                  eventSystem.AddComponent<EventSystem>();
                  eventSystem.AddComponent<StandaloneInputModule>();
            }

            // Метод инициализации, вызывается при старте
            private void Start()
            {
                  // Инициализируем цвет по умолчанию при старте
                  if (duluxColors != null && duluxColors.Count > 0)
                  {
                        selectedColor = duluxColors[0];
                        currentPaintColor = duluxColors[0];
                  }
                  else
                  {
                        selectedColor = new Color(0.2f, 0.6f, 1.0f);
                        currentPaintColor = selectedColor;
                  }

                  Debug.Log("RealWallPaintingController начинает работу...");

                  // Убедимся, что Canvas существует перед созданием UI
                  EnsureCanvasExists();

                  // Создаем материал подсветки
                  if (highlightMaterial == null)
                  {
                        highlightMaterial = CreateHighlightMaterial();
                        Debug.Log("Создан материал подсветки для стен");
                  }

                  // Проверяем и настраиваем компоненты
                  ValidateComponents();

                  // Настраиваем камеру и UI
                  InitializeCamera();
                  SetupUI();

                  // Настраиваем WallDetector для обнаружения стен
                  if (wallDetector != null)
                  {
                        Debug.Log("Настраиваю WallDetector для обнаружения стен");
                        wallDetector.mainCamera = mainCamera;

                        // Подписываемся на событие обнаружения стен
                        wallDetector.OnWallsDetected += OnWallsDetected;

                        // Инициализируем детектор стен с расширенными параметрами
                        try
                        {
                              ConfigureAdvancedWallDetection();
                              EnableContoursOnCamera();
                        }
                        catch (System.Exception ex)
                        {
                              Debug.LogError($"Ошибка при настройке детектора стен: {ex.Message}");
                        }

                        // Запускаем обнаружение стен
                        wallDetector.StartDetection();
                        Debug.Log("Запущено обнаружение стен");

                        // Проверка активности обнаружения стен
                        if (wallDetector.gameObject.activeInHierarchy && wallDetector.enabled)
                        {
                              Debug.Log("Детектор стен активен и готов к работе");
                        }
                        else
                        {
                              Debug.LogWarning("Детектор стен НЕ активен! Активируем его...");
                              wallDetector.gameObject.SetActive(true);
                              wallDetector.enabled = true;
                              // Повторный запуск обнаружения после активации
                              wallDetector.StartDetection();
                        }
                  }
                  else
                  {
                        Debug.LogError("WallDetector не назначен! Обнаружение стен не будет работать.");
                  }

                  // Запоминаем начальную позицию и вращение камеры
                  if (mainCamera != null)
                  {
                        lastCameraPosition = mainCamera.transform.position;
                        lastCameraRotation = mainCamera.transform.rotation;
                  }

                  // Создаем панель сообщений, если её еще нет
                  if (messagePanel == null)
                  {
                        CreateMessagePanel();
                        messagePanel.SetActive(false);
                  }

#if UNITY_EDITOR
                  // В режиме редактора создаем тестовые стены для удобства разработки
                  CreateTestWallsIfNeeded();

                  // Поворачиваем камеру к тестовым стенам для удобства
                  RotateCameraToFaceTestWalls();
#endif

                  // Инициализируем цветовую палитру
                  CreateColorPalette();

                  // Создаем кнопку для быстрой покраски всех стен
                  CreatePaintAllButton();

                  // Показываем приветственное сообщение
                  ShowMessage("Визуализатор покраски стен готов к работе. Нажмите кнопку Capture для начала.", 4f);

                  // В конце Start() отмечаем, что инициализация завершена
                  isInitialized = true;
                  Debug.Log("RealWallPaintingController полностью инициализирован");

                  // Запускаем корутину для улучшения видимости с небольшой задержкой
                  StartCoroutine(DelayedEnsureVisibility());
            }

            private void InitializeCamera()
            {
                  // Проверяем доступные веб-камеры
                  WebCamDevice[] devices = WebCamTexture.devices;
                  Debug.Log($"Найдены веб-камеры: {devices.Length}");

                  // Выводим информацию о камерах
                  foreach (WebCamDevice device in devices)
                  {
                        Debug.Log($"Камера: {device.name}");
                  }

                  if (devices.Length > 0)
                  {
                        // Выбираем первую камеру в списке (фронтальную камеру по умолчанию)
                        string cameraName = devices[0].name;
                        Debug.Log($"Выбрана веб-камера: {cameraName}");

                        // Создаем текстуру веб-камеры высокого разрешения
                        webCamTexture = new WebCamTexture(cameraName, 1280, 720, 30);
                        webCamTexture.Play();

                        // Добавляем проверку размера WebCamTexture после небольшой задержки
                        StartCoroutine(CheckWebCamTextureAfterDelay(2.0f));

                        // Находим компонент RawImage для отображения текстуры камеры
                        if (cameraPreview != null)
                        {
                              try
                              {
                                    // Устанавливаем текстуру
                                    cameraPreview.texture = webCamTexture;

                                    // Настраиваем прозрачность
                                    cameraPreview.color = new Color(1f, 1f, 1f, 0.85f);

                                    // Гарантируем, что компонент активен
                                    cameraPreview.enabled = true;
                                    cameraPreview.gameObject.SetActive(true);

                                    // Убедимся, что камера отображается на заднем плане
                                    cameraPreview.transform.SetAsFirstSibling();

                                    // Отладочная информация
                                    RectTransform rt = cameraPreview.rectTransform;
                                    Debug.Log($"Настроен RawImage для камеры: активен={cameraPreview.enabled}, " +
                                              $"видимость={cameraPreview.gameObject.activeSelf}, " +
                                              $"размер={rt.rect.width}x{rt.rect.height}");
                              }
                              catch (System.Exception ex)
                              {
                                    Debug.LogError($"Ошибка при настройке камеры: {ex.Message}");
                              }
                        }
                        else
                        {
                              Debug.LogError("Компонент RawImage для камеры не назначен!");

                              // Попробуем найти RawImage в сцене
                              RawImage[] rawImages = FindObjectsOfType<RawImage>();
                              if (rawImages.Length > 0)
                              {
                                    Debug.Log($"Найдено {rawImages.Length} RawImage компонентов. Используем первый.");
                                    cameraPreview = rawImages[0];
                                    cameraPreview.texture = webCamTexture;
                              }
                              else
                              {
                                    // Создаем новый RawImage для камеры
                                    Canvas canvas = FindObjectOfType<Canvas>();
                                    if (canvas == null)
                                    {
                                          Debug.Log("Canvas не найден, создаем новый");
                                          GameObject canvasObj = new GameObject("Canvas");
                                          canvas = canvasObj.AddComponent<Canvas>();
                                          canvas.renderMode = RenderMode.ScreenSpaceOverlay;
                                          canvasObj.AddComponent<CanvasScaler>();
                                          canvasObj.AddComponent<GraphicRaycaster>();
                                    }

                                    // Создаем GameObject для RawImage
                                    GameObject cameraObj = new GameObject("CameraPreview");
                                    cameraObj.transform.SetParent(canvas.transform, false);

                                    // Настраиваем RectTransform
                                    RectTransform rt = cameraObj.AddComponent<RectTransform>();
                                    rt.anchorMin = Vector2.zero;
                                    rt.anchorMax = Vector2.one;
                                    rt.offsetMin = Vector2.zero;
                                    rt.offsetMax = Vector2.zero;

                                    // Добавляем RawImage
                                    cameraPreview = cameraObj.AddComponent<RawImage>();
                                    cameraPreview.texture = webCamTexture;
                                    cameraPreview.color = new Color(1f, 1f, 1f, 0.85f);

                                    Debug.Log("Создан новый RawImage для отображения камеры");
                              }
                        }

                        // Настраиваем режим отображения камеры (полноэкранный)
                        SetCameraViewMode(true);

                        // Сообщаем пользователю
                        ShowMessage("Камера инициализирована и отображается на весь экран");
                  }
                  else
                  {
                        Debug.LogError("Не найдено ни одной веб-камеры!");
                  }
            }

            // Проверка WebCamTexture после инициализации с задержкой
            private IEnumerator CheckWebCamTextureAfterDelay(float delay)
            {
                  yield return new WaitForSeconds(delay);

                  if (webCamTexture != null)
                  {
                        // Проверяем, что веб-камера запущена и имеет нормальное разрешение
                        if (!webCamTexture.isPlaying || webCamTexture.width <= 16 || webCamTexture.height <= 16)
                        {
                              Debug.LogWarning($"WebCamTexture имеет неправильный размер или не запущена: isPlaying={webCamTexture.isPlaying}, размер={webCamTexture.width}x{webCamTexture.height}");

                              // Пробуем перезапустить камеру
                              ResetCamera();
                        }
                        else
                        {
                              Debug.Log($"WebCamTexture успешно инициализирована: размер={webCamTexture.width}x{webCamTexture.height}");

                              // Если размер RawImage не соответствует соотношению сторон WebCamTexture,
                              // исправляем это для корректного отображения
                              if (cameraPreview != null)
                              {
                                    RectTransform rt = cameraPreview.rectTransform;
                                    float webCamAspect = (float)webCamTexture.width / webCamTexture.height;
                                    float rectAspect = rt.rect.width / rt.rect.height;

                                    // Если аспект сильно отличается, корректируем
                                    if (Mathf.Abs(webCamAspect - rectAspect) > 0.1f)
                                    {
                                          Debug.Log($"Корректировка соотношения сторон RawImage: {rectAspect} -> {webCamAspect}");
                                          // Настройка будет выполнена через SetCameraViewMode
                                          SetCameraViewMode(isFullScreenCamera);
                                    }
                              }
                        }
                  }
            }

            // Метод для сброса и переинициализации камеры
            private void ResetCamera()
            {
                  Debug.Log("Перезапуск WebCamTexture...");

                  if (webCamTexture != null)
                  {
                        // Останавливаем текущую WebCamTexture
                        webCamTexture.Stop();

                        // Пауза перед повторным запуском
                        try
                        {
                              System.Threading.Thread.Sleep(100);
                        }
                        catch (System.Exception) { } // Игнорируем возможные ошибки

                        // Пробуем перезапустить с новыми параметрами
                        webCamTexture.requestedWidth = 1280;
                        webCamTexture.requestedHeight = 720;
                        webCamTexture.requestedFPS = 30;
                        webCamTexture.Play();

                        // Проверяем статус через некоторое время
                        StartCoroutine(CheckWebCamTextureAfterDelay(2.0f));
                  }
                  else
                  {
                        // Если WebCamTexture не существует, инициализируем заново
                        InitializeCamera();
                  }
            }

            // Метод для включения отображения контуров на камере
            private void ConfigureContoursOnCamera()
            {
                  if (wallDetector == null)
                  {
                        Debug.LogWarning("WallDetector не назначен, невозможно настроить отображение контуров");
                        return;
                  }

                  // Проверяем, есть ли у детектора стен функция для отображения контуров
                  if (cameraPreview != null)
                  {
                        // Проверяем, существует ли RawImage
                        if (!cameraPreview.gameObject.activeInHierarchy)
                        {
                              Debug.LogWarning("RawImage для камеры неактивен, активирую его");
                              cameraPreview.gameObject.SetActive(true);
                        }

                        // Создаем RawImage, если он отсутствует
                        if (cameraPreview == null)
                        {
                              Debug.LogWarning("RawImage для камеры не найден, создаю новый");
                              Canvas canvas = EnsureCanvasExists();

                              GameObject rawImageObj = new GameObject("CameraPreview");
                              rawImageObj.transform.SetParent(canvas.transform, false);

                              RectTransform rt = rawImageObj.AddComponent<RectTransform>();
                              rt.anchorMin = Vector2.zero;
                              rt.anchorMax = Vector2.one;
                              rt.offsetMin = Vector2.zero;
                              rt.offsetMax = Vector2.zero;

                              cameraPreview = rawImageObj.AddComponent<RawImage>();
                              cameraPreview.color = new Color(1f, 1f, 1f, 0.85f);
                        }

                        wallDetector.SetDebugImageDisplay(cameraPreview);
                        Debug.Log("Включено отображение контуров на камере");
                  }
            }

            // Добавляем обновление веб-камеры в метод Update
            private void Update()
            {
                  // Проверка статуса WebCamTexture
                  if (webCamTexture != null && Time.frameCount % 60 == 0) // Проверка каждые 60 кадров
                  {
                        if (!webCamTexture.isPlaying || (webCamTexture.width <= 16 && Time.frameCount > 120))
                        {
                              Debug.LogWarning($"WebCamTexture потеряла активность или имеет неправильный размер в Update: isPlaying={webCamTexture.isPlaying}, размер={webCamTexture.width}x{webCamTexture.height}");
                              // Пробуем перезапустить камеру, но не слишком часто
                              if (Time.time - lastCameraResetTime > 15.0f) // Не чаще раза в 15 секунд
                              {
                                    lastCameraResetTime = Time.time;
                                    ResetCamera();
                              }
                        }
                  }

                  // Остальной код Update...
            }

            // Добавляем переменную для отслеживания времени последнего сброса камеры
            private float lastCameraResetTime = 0f;

            // Метод для создания тестовых стен при запуске, если не обнаруживаются реальные
            private void CreateTestWallsIfNeeded()
            {
                  // Большое, заметное сообщение на весь экран
                  ShowBigScreenMessage("ВНИМАНИЕ! СОЗДАНЫ ТЕСТОВЫЕ СТЕНЫ\n\nНажмите ПРОБЕЛ для покраски стен\nНажмите T для пересоздания стен");

                  Debug.Log("ВНИМАНИЕ: Создаются тестовые стены для демонстрации");

                  // Явно очищаем старые маркеры с задержкой для предотвращения блокировки UI
                  ClearWallMarkers();

                  // Поворачиваем камеру в нужное положение для тестовых стен
                  RotateCameraToFaceTestWalls();

                  // Создаем либо тестовую комнату, либо отдельные стены
                  bool createRoom = true; // Флаг для выбора режима создания

                  if (createRoom)
                  {
                        CreateTestRoom();
                  }
                  else
                  {
                        CreateIndividualTestWalls();
                  }

                  // Показываем сообщение пользователю
                  ShowMessage("Созданы тестовые стены для демонстрации", 5.0f);
            }

            // Метод для поворота камеры в нужное положение для тестовых стен
            private void RotateCameraToFaceTestWalls()
            {
                  if (mainCamera == null) return;

                  // Устанавливаем камеру в позицию для просмотра тестовых стен
                  Vector3 cameraPosition = new Vector3(0, 1.7f, -3.0f);
                  Quaternion cameraRotation = Quaternion.Euler(0, 0, 0);

                  mainCamera.transform.position = cameraPosition;
                  mainCamera.transform.rotation = cameraRotation;

                  Debug.Log("Камера повернута для просмотра тестовых стен");
            }

            // Метод для создания индивидуальных тестовых стен (старый вариант)
            private void CreateIndividualTestWalls()
            {
                  List<WallData> testWalls = new List<WallData>();

                  // Создаем большую стену прямо перед камерой очень близко
                  testWalls.Add(new WallData
                  {
                        position = mainCamera.transform.position + mainCamera.transform.forward * 3.0f,
                        rotation = Quaternion.LookRotation(-mainCamera.transform.forward),
                        scale = new Vector3(3.0f, 2.0f, 0.1f)
                  });

                  // Создаем стену справа от камеры, очень близко
                  testWalls.Add(new WallData
                  {
                        position = mainCamera.transform.position + mainCamera.transform.right * 2.0f + mainCamera.transform.forward * 2.0f,
                        rotation = Quaternion.LookRotation(-mainCamera.transform.right),
                        scale = new Vector3(2.0f, 1.5f, 0.1f)
                  });

                  // Создаем стену слева от камеры, очень близко
                  testWalls.Add(new WallData
                  {
                        position = mainCamera.transform.position - mainCamera.transform.right * 2.0f + mainCamera.transform.forward * 2.0f,
                        rotation = Quaternion.LookRotation(mainCamera.transform.right),
                        scale = new Vector3(2.0f, 1.5f, 0.1f)
                  });

                  // Создаем стену над камерой, очень близко
                  testWalls.Add(new WallData
                  {
                        position = mainCamera.transform.position + Vector3.up * 2.0f + mainCamera.transform.forward * 2.0f,
                        rotation = Quaternion.LookRotation(Vector3.down),
                        scale = new Vector3(2.0f, 2.0f, 0.1f)
                  });

                  // Создаем стену под камерой, очень близко
                  testWalls.Add(new WallData
                  {
                        position = mainCamera.transform.position + Vector3.down * 0.5f + mainCamera.transform.forward * 2.0f,
                        rotation = Quaternion.LookRotation(Vector3.up),
                        scale = new Vector3(2.0f, 2.0f, 0.1f)
                  });

                  // Обрабатываем тестовые стены
                  OnWallsDetected(testWalls);

                  Debug.Log($"Созданы {testWalls.Count} отдельных тестовых стен относительно камеры в позиции {mainCamera.transform.position}");
            }

            // Метод для создания тестовой комнаты вокруг камеры
            private void CreateTestRoom()
            {
                  List<WallData> roomWalls = new List<WallData>();

                  // Задаем размеры комнаты
                  float roomWidth = 5.0f;  // По оси X
                  float roomLength = 5.0f; // По оси Z
                  float roomHeight = 3.0f; // По оси Y
                  float wallThickness = 0.1f;

                  // Определяем центр комнаты относительно камеры
                  Vector3 roomCenter = mainCamera.transform.position;
                  roomCenter.y = mainCamera.transform.position.y - 0.5f; // Слегка опускаем центр комнаты ниже камеры

                  // Определяем позиции стен относительно центра комнаты
                  float halfWidth = roomWidth / 2;
                  float halfLength = roomLength / 2;
                  float halfHeight = roomHeight / 2;

                  // Создаем переднюю стену (впереди от камеры)
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(0, 0, halfLength),
                        rotation = Quaternion.LookRotation(Vector3.back), // Смотрит на камеру
                        scale = new Vector3(roomWidth, roomHeight, wallThickness)
                  });

                  // Создаем заднюю стену (позади камеры)
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(0, 0, -halfLength),
                        rotation = Quaternion.LookRotation(Vector3.forward),
                        scale = new Vector3(roomWidth, roomHeight, wallThickness)
                  });

                  // Создаем правую стену
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(halfWidth, 0, 0),
                        rotation = Quaternion.LookRotation(Vector3.left),
                        scale = new Vector3(roomLength, roomHeight, wallThickness)
                  });

                  // Создаем левую стену
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(-halfWidth, 0, 0),
                        rotation = Quaternion.LookRotation(Vector3.right),
                        scale = new Vector3(roomLength, roomHeight, wallThickness)
                  });

                  // Создаем пол
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(0, -halfHeight, 0),
                        rotation = Quaternion.LookRotation(Vector3.up),
                        scale = new Vector3(roomWidth, roomLength, wallThickness)
                  });

                  // Создаем потолок
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(0, halfHeight, 0),
                        rotation = Quaternion.LookRotation(Vector3.down),
                        scale = new Vector3(roomWidth, roomLength, wallThickness)
                  });

                  // Добавляем мебель или объекты для демонстрации (например, картину на стене)
                  roomWalls.Add(new WallData
                  {
                        position = roomCenter + new Vector3(0, 0, halfLength - 0.05f) + new Vector3(1.0f, 0.3f, 0),
                        rotation = Quaternion.LookRotation(Vector3.back),
                        scale = new Vector3(1.5f, 1.0f, 0.05f)
                  });

                  // Обрабатываем стены комнаты
                  OnWallsDetected(roomWalls);

                  Debug.Log($"Создана тестовая комната с {roomWalls.Count} стенами вокруг камеры в позиции {mainCamera.transform.position}");
            }

            private void ValidateComponents()
            {
                  if (mainCamera == null)
                  {
                        mainCamera = Camera.main;
                  }

                  if (wallDetector == null)
                  {
                        wallDetector = GetComponent<WallDetector>();
                  }

                  if (textureManager == null)
                  {
                        textureManager = FindObjectOfType<TextureManager>();
                  }

                  if (cameraPreview == null)
                  {
                        Debug.LogError("RealWallPaintingController: Camera preview RawImage is not assigned!");
                  }

                  if (mainCamera == null || wallDetector == null || textureManager == null || cameraPreview == null)
                  {
                        Debug.LogError("RealWallPaintingController: Missing required components!");
                        enabled = false;
                  }
            }

            private void SetupUI()
            {
                  if (captureButton != null)
                  {
                        captureButton.onClick.AddListener(OnCaptureButtonClicked);
                  }

                  if (resetButton != null)
                  {
                        resetButton.onClick.AddListener(OnResetButtonClicked);
                  }

                  if (toggleModeButton != null)
                  {
                        toggleModeButton.onClick.AddListener(OnToggleModeButtonClicked);
                  }
                  else
                  {
                        // Create toggle mode button if not assigned
                        CreateToggleModeButton();
                  }

                  if (wallDetector != null && cameraPreview != null)
                  {
                        wallDetector.SetDebugImageDisplay(cameraPreview);
                  }

                  // Hide color palette initially since we start in detection mode
                  if (colorPalettePanel != null)
                  {
                        colorPalettePanel.SetActive(false);
                  }
            }

            private void CreateToggleModeButton()
            {
                  // Check if we have a canvas to add the button to
                  Canvas canvas = FindObjectOfType<Canvas>();
                  if (canvas == null)
                  {
                        Debug.LogWarning("No canvas found to create toggle mode button");
                        return;
                  }

                  // Create button GameObject
                  GameObject buttonObj = new GameObject("ToggleModeButton");
                  buttonObj.transform.SetParent(canvas.transform, false);

                  // Add button components
                  Image buttonImage = buttonObj.AddComponent<Image>();
                  buttonImage.color = new Color(0.2f, 0.2f, 0.2f, 0.8f);
                  toggleModeButton = buttonObj.AddComponent<Button>();

                  // Add text
                  GameObject textObj = new GameObject("Text");
                  textObj.transform.SetParent(buttonObj.transform, false);
                  Text buttonText = textObj.AddComponent<Text>();

                  // Try to find a font
                  Font font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
                  if (font == null)
                  {
                        Font[] fonts = Resources.FindObjectsOfTypeAll<Font>();
                        if (fonts.Length > 0)
                        {
                              font = fonts[0];
                        }
                  }

                  buttonText.font = font;
                  buttonText.text = "MODE";
                  buttonText.fontSize = 18;
                  buttonText.alignment = TextAnchor.MiddleCenter;
                  buttonText.color = Color.white;

                  // Configure button layout
                  RectTransform textRect = textObj.GetComponent<RectTransform>();
                  textRect.anchorMin = Vector2.zero;
                  textRect.anchorMax = Vector2.one;
                  textRect.offsetMin = Vector2.zero;
                  textRect.offsetMax = Vector2.zero;

                  // Position the button in top-right corner
                  RectTransform buttonRect = buttonObj.GetComponent<RectTransform>();
                  buttonRect.anchorMin = new Vector2(1, 1);
                  buttonRect.anchorMax = new Vector2(1, 1);
                  buttonRect.pivot = new Vector2(1, 1);
                  buttonRect.sizeDelta = new Vector2(80, 40);
                  buttonRect.anchoredPosition = new Vector2(-10, -10);

                  // Add listener
                  toggleModeButton.onClick.AddListener(OnToggleModeButtonClicked);
            }

            private void OnToggleModeButtonClicked()
            {
                  // Переключаем режим
                  isPaintingMode = !isPaintingMode;

                  Debug.Log($"Режим переключен на: {(isPaintingMode ? "Покраска" : "Обнаружение")}");

                  // Обновляем UI в соответствии с выбранным режимом
                  UpdateModeUI();

                  if (isPaintingMode)
                  {
                        // Режим покраски - останавливаем обнаружение стен и показываем палитру цветов
                        if (isCapturing)
                        {
                              StopCapture();
                        }

                        // Включаем обработку покраски
                        isPaintMode = true;

                        // Показываем цветовую палитру
                        if (colorPaletteContainer != null)
                        {
                              colorPaletteContainer.gameObject.SetActive(true);
                        }
                        else
                        {
                              CreateColorPalette();
                        }

                        // Создаем кнопку для быстрой покраски всех стен
                        CreatePaintAllButton();

                        // Показываем контуры стен для выбора
                        UpdateWallMarkersVisibility(true);

                        ShowMessage("Режим покраски. Выберите цвет и нажмите на стену для покраски, или используйте кнопку 'ЗАКРАСИТЬ ВСЕ СТЕНЫ'.", 4f);
                  }
                  else
                  {
                        // Режим обнаружения - запускаем обнаружение стен и скрываем палитру
                        isPaintMode = false;

                        // Скрываем цветовую палитру
                        if (colorPaletteContainer != null)
                        {
                              colorPaletteContainer.gameObject.SetActive(false);
                        }

                        // Скрываем кнопку покраски всех стен
                        GameObject paintAllButton = GameObject.Find("PaintAllButton");
                        if (paintAllButton != null)
                        {
                              paintAllButton.SetActive(false);
                        }

                        // Если не активно обнаружение, запускаем его
                        if (!isCapturing && wallDetector != null)
                        {
                              StartCapture();
                        }

                        ShowMessage("Режим обнаружения стен. Нажмите кнопку Capture для начала обнаружения.", 4f);
                  }
            }

            private void UpdateModeUI()
            {
                  // Update button text if available
                  if (toggleModeButton != null)
                  {
                        Text buttonText = toggleModeButton.GetComponentInChildren<Text>();
                        if (buttonText != null)
                        {
                              buttonText.text = isPaintingMode ? "DETECT" : "PAINT";
                        }
                  }

                  // Show/hide color palette based on mode
                  if (colorPalettePanel != null)
                  {
                        colorPalettePanel.SetActive(isPaintingMode);
                  }

                  // Enable/disable wall detector based on mode
                  if (wallDetector != null)
                  {
                        if (isPaintingMode)
                        {
                              wallDetector.StopDetection();
                        }
                        else
                        {
                              wallDetector.StartDetection();
                        }
                  }

                  // Show/hide wall markers based on mode
                  UpdateWallMarkersVisibility(!isPaintingMode);

                  // Update capture button text/icon if available
                  if (captureButton != null)
                  {
                        Text captureText = captureButton.GetComponentInChildren<Text>();
                        if (captureText != null)
                        {
                              captureText.text = isPaintingMode ? "Apply" : "Capture";
                        }
                  }
            }

            private void OnCaptureButtonClicked()
            {
                  if (isPaintingMode)
                  {
                        // In painting mode, apply colors to all walls
                        PaintAllWalls();
                  }
                  else
                  {
                        // In detection mode, toggle wall detection
                        if (!isCapturing)
                        {
                              StartCapture();
                        }
                        else
                        {
                              StopCapture();
                        }
                  }
            }

            private void OnResetButtonClicked()
            {
                  detectedWalls.Clear();
                  if (wallDetector != null)
                  {
                        wallDetector.StopDetection();
                  }
                  isCapturing = false;
                  UpdateUI();
            }

            private void StartCapture()
            {
                  Debug.Log("Запуск обнаружения стен через OpenCV...");

                  // Получаем компонент WallDetector и настраиваем его
                  wallDetector = GetComponent<WallDetector>();
                  if (wallDetector == null)
                  {
                        wallDetector = gameObject.AddComponent<WallDetector>();
                  }

                  // Настраиваем параметры детектора для более точного обнаружения стен
                  ConfigureAdvancedWallDetection();

                  // Включаем отображение контуров на видеопотоке
                  EnableContoursOnCamera();

                  // Убедимся что RawImage для предпросмотра камеры виден и настроен
                  if (cameraPreview != null)
                  {
                        // Делаем компонент активным и видимым
                        cameraPreview.gameObject.SetActive(true);
                        cameraPreview.color = Color.white; // Полная непрозрачность

                        // Настраиваем превью камеры как маленькое окно в нижнем правом углу
                        RectTransform rectTransform = cameraPreview.GetComponent<RectTransform>();
                        if (rectTransform != null)
                        {
                              // Устанавливаем якорь в правый нижний угол
                              rectTransform.anchorMin = new Vector2(0.7f, 0.05f);
                              rectTransform.anchorMax = new Vector2(0.95f, 0.25f);
                              rectTransform.offsetMin = Vector2.zero;
                              rectTransform.offsetMax = Vector2.zero;

                              // Устанавливаем правильное соотношение сторон и выравнивание
                              rectTransform.pivot = new Vector2(0.5f, 0.5f);
                              // RawImage не поддерживает preserveAspect, поэтому настраиваем UVRect
                              cameraPreview.uvRect = new UnityEngine.Rect(0, 0, 1, 1);
                        }

                        // Создаем отдельный объект для границы вместо добавления Image компонента к самому cameraPreview
                        Transform parentTransform = cameraPreview.transform.parent;

                        // Проверяем, существует ли уже граница
                        GameObject borderObj = GameObject.Find("CameraPreviewBorder");
                        if (borderObj == null)
                        {
                              // Создаем новый объект для границы
                              borderObj = new GameObject("CameraPreviewBorder");
                              borderObj.transform.SetParent(parentTransform);

                              // Копируем RectTransform настройки от cameraPreview
                              RectTransform borderRect = borderObj.AddComponent<RectTransform>();
                              RectTransform previewRect = cameraPreview.GetComponent<RectTransform>();

                              if (previewRect != null)
                              {
                                    borderRect.anchorMin = previewRect.anchorMin;
                                    borderRect.anchorMax = previewRect.anchorMax;
                                    borderRect.offsetMin = new Vector2(previewRect.offsetMin.x - 5, previewRect.offsetMin.y - 5);
                                    borderRect.offsetMax = new Vector2(previewRect.offsetMax.x + 5, previewRect.offsetMax.y + 5);
                                    borderRect.pivot = previewRect.pivot;
                              }

                              // Добавляем Image компонент для рамки
                              Image borderImage = borderObj.AddComponent<Image>();
                              borderImage.color = new Color(1f, 1f, 1f, 0.3f); // Полупрозрачная белая рамка

                              // Размещаем объект границы за превью камеры
                              borderObj.transform.SetSiblingIndex(cameraPreview.transform.GetSiblingIndex());
                        }
                  }

                  // Настраиваем отображение отладочной информации в WallDetector
                  var showDebugLinesField = wallDetector.GetType().GetField("showDebugLines", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
                  if (showDebugLinesField != null)
                  {
                        showDebugLinesField.SetValue(wallDetector, true); // Всегда включаем отображение контуров
                  }

                  // Подписываемся на событие обнаружения стен
                  wallDetector.OnWallsDetected += OnWallsDetected;

                  // Запускаем обнаружение реальных стен через камеру
                  wallDetector.StartDetection();

                  // Показываем подсказку пользователю о необходимости направить камеру на стены
                  ShowMessage("Камера показана в нижнем правом углу. Нажмите ПРОБЕЛ для покраски стен.", 5.0f);
            }

            private void StopCapture()
            {
                  isCapturing = false;
                  if (wallDetector != null)
                  {
                        wallDetector.StopDetection();
                  }
                  UpdateUI();
            }

            private void OnWallsDetected(List<WallData> walls)
            {
                  // Проверка на null
                  if (walls == null)
                  {
                        Debug.LogWarning("OnWallsDetected: получен null вместо списка стен");
                        return;
                  }

                  // Сохраняем стены
                  detectedWalls = new List<WallData>(walls);

                  // Логируем количество стен
                  Debug.Log($"Обнаружено стен: {walls.Count}");

                  // Очищаем предыдущие маркеры с задержкой для предотвращения блокировки UI
                  StartCoroutine(ProcessWallsWithDelay(walls));
            }

            private IEnumerator ProcessWallsWithDelay(List<WallData> walls)
            {
                  // Очищаем существующие маркеры
                  ClearWallMarkers();

                  // Создаем родительский объект для новых маркеров, если его еще нет
                  GameObject wallMarkersParent = GameObject.Find("WallMarkers");
                  if (wallMarkersParent == null)
                  {
                        wallMarkersParent = new GameObject("WallMarkers");
                  }

                  // Обрабатываем каждую стену с небольшой задержкой
                  for (int i = 0; i < walls.Count; i++)
                  {
                        if (i > 0 && i % 2 == 0)
                        {
                              // После каждых 2 стен делаем паузу чтобы не блокировать UI
                              yield return new WaitForEndOfFrame();
                        }

                        WallData wall = walls[i];
                        CreateWallMarker(wall, wallMarkersParent.transform);
                        Debug.Log($"Создан маркер для стены #{wall.id} в позиции ({wall.position.x:F2}, {wall.position.y:F2}, {wall.position.z:F2}), размеры: {wall.width}x{wall.height}");
                  }

                  // Показываем сообщение пользователю
                  ShowMessage($"Обнаружено стен: {walls.Count}. Вы можете переключиться в режим покраски.", 5f);

                  // Если обнаружено несколько стен, переключаемся в режим покраски
                  if (walls.Count > 1)
                  {
                        StartCoroutine(SwitchToPaintModeAfterDelay(1.5f));
                  }
            }

            // Корутина для переключения в режим покраски с задержкой
            private IEnumerator SwitchToPaintModeAfterDelay(float delay)
            {
                  yield return new WaitForSeconds(delay);

                  if (!isPaintingMode)
                  {
                        Debug.Log("Автоматическое переключение в режим покраски");
                        isPaintingMode = true;
                        UpdateModeUI();

                        // Включаем режим покраски
                        isPaintMode = true;

                        // Показываем цветовую палитру
                        if (colorPaletteContainer != null)
                        {
                              colorPaletteContainer.gameObject.SetActive(true);
                        }
                        else
                        {
                              CreateColorPalette();
                        }

                        // Создаем кнопку для быстрой покраски всех стен
                        CreatePaintAllButton();

                        ShowMessage("Режим покраски активирован. Выберите цвет и нажмите на стену или используйте кнопку 'ЗАКРАСИТЬ ВСЕ СТЕНЫ'", 4f);
                  }
            }

            // Метод для очистки визуальных маркеров стен
            private void ClearWallMarkers()
            {
                  GameObject markersParent = GameObject.Find("WallMarkersContainer");
                  if (markersParent != null)
                  {
                        foreach (Transform child in markersParent.transform)
                        {
                              Destroy(child.gameObject);
                        }
                  }
            }

            // Метод для создания визуального маркера стены
            private void CreateWallMarker(WallData wall, Transform parent)
            {
                  Debug.Log($"Создаю маркер в мировой позиции: {wall.position.ToString("F2")}, поворот: {wall.rotation.eulerAngles.ToString("F2")}");

                  try
                  {
                        // Создаем новый объект для маркера стены
                        GameObject marker = new GameObject($"WallMarker_{wall.id}");
                        marker.transform.SetParent(parent);
                        marker.transform.position = wall.position;
                        marker.transform.rotation = wall.rotation;
                        marker.transform.localScale = Vector3.one;

                        // Добавляем компонент рендерера для визуализации
                        MeshFilter meshFilter = marker.AddComponent<MeshFilter>();
                        MeshRenderer meshRenderer = marker.AddComponent<MeshRenderer>();
                        meshFilter.mesh = CreateWallMesh(wall.width, wall.height);

                        // Настраиваем размеры
                        float scaleFactor = 5.0f; // Увеличиваем размер для лучшей видимости
                        marker.transform.localScale = new Vector3(scaleFactor, scaleFactor, 1);
                        Debug.Log($"Размер маркера: {wall.width * scaleFactor}x{wall.height * scaleFactor}");

                        // Настраиваем материал для визуализации
                        Material wallMaterial = null;
                        try
                        {
                              // Пытаемся найти шейдеры в порядке предпочтения
                              Shader wallShader = Shader.Find("Standard");
                              if (wallShader == null) wallShader = Shader.Find("Diffuse");
                              if (wallShader == null) wallShader = Shader.Find("Sprites/Default");
                              if (wallShader == null) wallShader = Shader.Find("Hidden/Internal-Colored");

                              if (wallShader != null)
                              {
                                    wallMaterial = new Material(wallShader);
                              }
                              else
                              {
                                    // Используем базовый материал, если не найден ни один шейдер
                                    wallMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                                    Debug.LogWarning("Не найдены стандартные шейдеры. Используется материал по умолчанию.");
                              }
                        }
                        catch (System.Exception ex)
                        {
                              Debug.LogError($"Ошибка при создании материала стены: {ex.Message}");
                              // Крайний случай - создаем новый материал из стандартных ресурсов
                              wallMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                        }

                        // Настройка материала
                        if (wallMaterial != null)
                        {
                              // Выбираем цвет исходя из номера стены (для разнообразия)
                              Color wallColor = GetDefaultWallColor(wall.id);
                              wallMaterial.color = new Color(wallColor.r, wallColor.g, wallColor.b, 0.8f); // Повышаем непрозрачность до 80%

                              // Выводим цвет в HEX-формате для отладки
                              Debug.Log($"Стене {wall.id} назначен цвет: {ColorToHex(wallColor)}");

                              // Если у нас стандартный шейдер, настраиваем прозрачность
                              if (wallMaterial.shader.name == "Standard")
                              {
                                    wallMaterial.SetFloat("_Mode", 3); // Transparent mode
                                    wallMaterial.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                                    wallMaterial.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                                    wallMaterial.SetInt("_ZWrite", 0);
                                    wallMaterial.DisableKeyword("_ALPHATEST_ON");
                                    wallMaterial.EnableKeyword("_ALPHABLEND_ON");
                                    wallMaterial.DisableKeyword("_ALPHAPREMULTIPLY_ON");
                                    wallMaterial.renderQueue = 3000;
                              }

                              // Применяем материал
                              meshRenderer.material = wallMaterial;
                        }

                        // Настраиваем collider для взаимодействия
                        MeshCollider meshCollider = marker.AddComponent<MeshCollider>();
                        meshCollider.sharedMesh = meshFilter.mesh;
                        meshCollider.convex = true;

                        // Установка слоя для взаимодействия с raycast
                        marker.layer = LayerMask.NameToLayer("Wall");
                        if (marker.layer == 0)
                        {
                              // Если слой Wall не существует, пробуем создать его или использовать Default
                              marker.layer = 0;
                        }

                        try
                        {
                              // Добавляем красивую обводку стены для лучшей видимости
                              AddEnhancedWallBorder(marker.transform, wall.width, wall.height);
                              Debug.Log("Добавлена расширенная обводка стены");

                              // Добавляем материал с гридом для визуализации стены
                              if (wallMaterial != null)
                              {
                                    Texture2D gridTexture = CreateGridTexture(32, new Color(0.2f, 0.2f, 0.2f, 0.8f),
                                                                              new Color(1f, 1f, 1f, 0.2f));
                                    wallMaterial.mainTexture = gridTexture;
                                    Debug.Log("Создан маркер стены с материалом " + wallMaterial.shader.name);
                              }

                              // Добавляем номер стены
                              AddWallNumberIndicator(marker.transform, wall);
                              Debug.Log("Добавлен индикатор номера стены");

                              // Добавляем яркие маркеры в углах для лучшей видимости
                              AddBrightCornerMarkers(marker.transform, wall.width, wall.height);
                              Debug.Log("Добавлены яркие маркеры углов");

                              // Добавляем маркер нормали стены
                              AddWallNormalIndicator(marker.transform);
                              Debug.Log("Добавлен индикатор нормали стены");

                              // Добавляем индикатор типа поверхности
                              AddSurfaceTypeIndicator(marker.transform, false, wall.width, wall.height);
                              Debug.Log($"Создан маркер поверхности в позиции {wall.position}");
                        }
                        catch (System.Exception ex)
                        {
                              Debug.LogWarning($"Предупреждение при добавлении дополнительных элементов маркера: {ex.Message}");
                        }

                        // Устанавливаем порядок сортировки для всех MeshRenderer, чтобы они были поверх камеры
                        MeshRenderer[] renderers = marker.GetComponentsInChildren<MeshRenderer>();
                        foreach (MeshRenderer renderer in renderers)
                        {
                              renderer.sortingOrder = 5;
                        }

                        // Добавляем маркер в список для отслеживания
                        wallMarkers.Add(marker);
                  }
                  catch (System.Exception e)
                  {
                        Debug.LogError($"Ошибка при создании маркера стены: {e.Message}\n{e.StackTrace}");
                  }
            }

            // Метод для создания сетки стены
            private Mesh CreateWallMesh(float width, float height)
            {
                  // Создаем плоский квадрат для стены
                  Mesh mesh = new Mesh();

                  // Координаты вершин (квадрат 1x1)
                  mesh.vertices = new Vector3[]
                  {
                        new Vector3(-0.5f, -0.5f, 0), // нижний левый
                        new Vector3(0.5f, -0.5f, 0),  // нижний правый
                        new Vector3(0.5f, 0.5f, 0),   // верхний правый
                        new Vector3(-0.5f, 0.5f, 0)   // верхний левый
                  };

                  // Индексы треугольников (2 треугольника для квадрата)
                  mesh.triangles = new int[] { 0, 1, 2, 0, 2, 3 };

                  // UV-координаты для текстуры
                  mesh.uv = new Vector2[]
                  {
                        new Vector2(0, 0),
                        new Vector2(1, 0),
                        new Vector2(1, 1),
                        new Vector2(0, 1)
                  };

                  // Нормали (все смотрят вперед)
                  mesh.normals = new Vector3[]
                  {
                        Vector3.forward,
                        Vector3.forward,
                        Vector3.forward,
                        Vector3.forward
                  };

                  mesh.RecalculateBounds();
                  return mesh;
            }

            // Метод для получения цвета стены по умолчанию в зависимости от ID
            private Color GetDefaultWallColor(int wallId)
            {
                  // Массив предопределенных ярких пастельных цветов для стен
                  Color[] wallColors = new Color[]
                  {
                        new Color(0.9f, 0.9f, 0.9f, 0.7f),  // Почти белый
                        new Color(1.0f, 0.8f, 0.8f, 0.7f),  // Розовый
                        new Color(0.8f, 0.9f, 1.0f, 0.7f),  // Голубой
                        new Color(0.9f, 1.0f, 0.8f, 0.7f),  // Светло-зеленый
                        new Color(1.0f, 0.9f, 0.8f, 0.7f),  // Персиковый
                        new Color(0.9f, 0.8f, 1.0f, 0.7f),  // Лавандовый
                        new Color(0.8f, 1.0f, 0.9f, 0.7f),  // Мятный
                        new Color(1.0f, 1.0f, 0.8f, 0.7f)   // Кремовый
                  };

                  // Возвращаем цвет из массива, циклически выбирая по ID стены
                  int colorIndex = Mathf.Max(0, (wallId - 1) % wallColors.Length);

                  return wallColors[colorIndex];
            }

            // Метод для создания материала подсветки
            private Material CreateHighlightMaterial()
            {
                  // Create a new material with the standard shader
                  Material highlightMaterial = new Material(Shader.Find("Standard"));
                  // Set properties for highlighting
                  highlightMaterial.color = new Color(1f, 0.8f, 0.2f, 0.7f); // Yellow highlight
                  highlightMaterial.EnableKeyword("_EMISSION");
                  highlightMaterial.SetColor("_EmissionColor", Color.yellow * 0.5f);

                  return highlightMaterial;
            }

            // Метод для обеспечения наличия Canvas в сцене
            private Canvas EnsureCanvasExists()
            {
                  Canvas canvas = FindObjectOfType<Canvas>();
                  if (canvas == null)
                  {
                        Debug.Log("Canvas не найден, создаем новый");
                        GameObject canvasObj = new GameObject("Canvas");
                        canvas = canvasObj.AddComponent<Canvas>();
                        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
                        canvasObj.AddComponent<CanvasScaler>();
                        canvasObj.AddComponent<GraphicRaycaster>();

                        // Добавляем EventSystem если его нет
                        if (FindObjectOfType<EventSystem>() == null)
                        {
                              GameObject eventSystemObj = new GameObject("EventSystem");
                              eventSystemObj.AddComponent<EventSystem>();
                              eventSystemObj.AddComponent<StandaloneInputModule>();
                        }
                  }
                  return canvas;
            }

            // Метод для обновления UI в зависимости от режима
            private void UpdateUI()
            {
                  if (captureButton != null)
                  {
                        var buttonText = captureButton.GetComponentInChildren<Text>();
                        if (buttonText != null)
                        {
                              buttonText.text = isCapturing ? "Stop" : "Capture";
                        }
                  }

                  // Добавляем кнопку для быстрой покраски всех стен, если её ещё нет
                  if (isPaintingMode && FindObjectOfType<Button>()?.name == "PaintAllButton" == false)
                  {
                        CreatePaintAllButton();
                  }
            }

            // Метод для настройки режима отображения камеры
            public void SetCameraViewMode(bool fullscreen)
            {
                  isFullScreenCamera = fullscreen;

                  if (cameraPreview == null)
                  {
                        Debug.LogWarning("Camera preview not assigned, can't change view mode");
                        return;
                  }

                  // Получаем размеры экрана
                  float screenWidth = Screen.width;
                  float screenHeight = Screen.height;

                  // Устанавливаем режим отображения
                  if (fullscreen)
                  {
                        // Полноэкранный режим - камера занимает весь экран
                        // Важно: размещаем камеру на слое позади 3D объектов
                        cameraPreview.rectTransform.anchoredPosition = Vector2.zero;
                        cameraPreview.rectTransform.sizeDelta = new Vector2(screenWidth, screenHeight);

                        // Устанавливаем Z-позицию для RawImage, чтобы он был за 3D объектами
                        cameraPreview.transform.SetAsFirstSibling(); // Важно: размещаем изображение камеры первым в иерархии Canvas
                        cameraPreview.color = new Color(1, 1, 1, 0.7f); // Делаем изображение камеры полупрозрачным

                        // Проверяем Canvas и настраиваем его для корректного отображения 3D объектов
                        Canvas canvas = cameraPreview.GetComponentInParent<Canvas>();
                        if (canvas != null)
                        {
                              // Настраиваем Canvas для корректного отображения 3D объектов поверх камеры
                              canvas.renderMode = RenderMode.ScreenSpaceOverlay;
                              canvas.sortingOrder = -1; // Убеждаемся, что Canvas находится позади 3D объектов
                              Debug.Log("Canvas настроен для показа 3D объектов поверх камеры");
                        }
                  }
                  else
                  {
                        // Режим миниатюры - камера занимает только часть экрана
                        float previewSize = screenWidth * 0.25f;
                        cameraPreview.rectTransform.anchoredPosition = new Vector2(previewSize / 2, previewSize / 2);
                        cameraPreview.rectTransform.sizeDelta = new Vector2(previewSize, previewSize * 0.75f);
                        cameraPreview.color = Color.white; // Возвращаем полную непрозрачность
                  }

                  Debug.Log($"Режим камеры установлен: {(fullscreen ? "полноэкранный" : "миниатюра")}");

                  // Информируем пользователя об изменении режима
                  string message = fullscreen
                       ? "Камера в полноэкранном режиме. 3D объекты должны быть видимы."
                       : "Камера в режиме миниатюры.";
                  ShowMessage(message, 3f);

                  // Форсируем обновление дочерних элементов Canvas для применения изменений
                  LayoutRebuilder.ForceRebuildLayoutImmediate(cameraPreview.rectTransform);
            }

            // Метод для обновления видимости маркеров стен
            private void UpdateWallMarkersVisibility(bool visible)
            {
                  foreach (var marker in wallMarkers)
                  {
                        if (marker != null)
                        {
                              marker.SetActive(visible);
                        }
                  }
            }

            // Метод для создания текстуры с сеткой
            private Texture2D CreateGridTexture(int size, Color lineColor, Color backgroundColor)
            {
                  Texture2D texture = new Texture2D(size, size, TextureFormat.RGBA32, false);
                  Color[] pixels = new Color[size * size];

                  int gridSize = size / 16; // 16 ячеек сетки
                  int lineThickness = 2; // Толщина линий сетки

                  for (int y = 0; y < size; y++)
                  {
                        for (int x = 0; x < size; x++)
                        {
                              int index = y * size + x;

                              // Рисуем линии сетки с заданной толщиной
                              if (x % gridSize < lineThickness || y % gridSize < lineThickness)
                              {
                                    pixels[index] = lineColor;
                              }
                              else
                              {
                                    pixels[index] = backgroundColor;
                              }

                              // Добавляем более толстую рамку по периметру
                              if (x < lineThickness * 2 || x > size - lineThickness * 2 - 1 ||
                                  y < lineThickness * 2 || y > size - lineThickness * 2 - 1)
                              {
                                    pixels[index] = lineColor;
                              }
                        }
                  }

                  texture.SetPixels(pixels);
                  texture.Apply();
                  return texture;
            }

            // Метод для создания улучшенной обводки стены
            private void AddEnhancedWallBorder(Transform parentTransform, float width, float height)
            {
                  GameObject borderObj = new GameObject("WallBorder");
                  borderObj.transform.SetParent(parentTransform);
                  borderObj.transform.localPosition = Vector3.zero;
                  borderObj.transform.localRotation = Quaternion.identity;
                  borderObj.transform.localScale = Vector3.one;

                  LineRenderer lineRenderer = borderObj.AddComponent<LineRenderer>();
                  lineRenderer.useWorldSpace = false;
                  lineRenderer.startWidth = 0.05f; // Увеличенная ширина для лучшей видимости
                  lineRenderer.endWidth = 0.05f;
                  lineRenderer.positionCount = 5;

                  // Создаем яркий светящийся материал для линии - с проверкой на существование шейдера
                  Material lineMaterial;
                  try
                  {
                        // Пытаемся найти шейдеры в порядке предпочтения
                        Shader shader = Shader.Find("Particles/Additive");
                        if (shader == null) shader = Shader.Find("Sprites/Default");
                        if (shader == null) shader = Shader.Find("Standard");
                        if (shader == null) shader = Shader.Find("Diffuse");
                        if (shader == null) shader = Shader.Find("Hidden/Internal-Colored");

                        if (shader != null)
                        {
                              lineMaterial = new Material(shader);
                              lineMaterial.color = Color.yellow; // Яркий желтый цвет
                        }
                        else
                        {
                              // Если не нашли подходящий шейдер, используем материал по умолчанию
                              Debug.LogWarning("Не удалось найти подходящий шейдер для границы стены. Используем стандартный материал.");
                              lineMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                        }
                  }
                  catch (System.Exception ex)
                  {
                        Debug.LogError($"Ошибка при создании материала для границы стены: {ex.Message}");
                        // Крайний случай - создаем новый материал из существующих ресурсов
                        lineMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                  }

                  if (lineMaterial != null)
                  {
                        lineMaterial.color = Color.yellow; // Устанавливаем цвет в любом случае
                        lineRenderer.material = lineMaterial;
                  }
                  else
                  {
                        Debug.LogWarning("Не удалось создать материал для границы стены! Используем стандартный материал линии.");
                  }

                  // Создаем прямоугольник вокруг стены
                  float hw = width * 0.5f;
                  float hh = height * 0.5f;

                  lineRenderer.SetPositions(new Vector3[] {
                        new Vector3(-hw, -hh, 0.01f),
                        new Vector3(hw, -hh, 0.01f),
                        new Vector3(hw, hh, 0.01f),
                        new Vector3(-hw, hh, 0.01f),
                        new Vector3(-hw, -hh, 0.01f)
                  });
            }

            // Метод для добавления крупного номера стены
            private void AddWallNumberIndicator(Transform parentTransform, WallData wall)
            {
                  try
                  {
                        // Создаем объект для крупного номера стены
                        GameObject textObj = new GameObject("WallNumberIndicator");
                        textObj.transform.SetParent(parentTransform);
                        textObj.transform.localPosition = new Vector3(0, 0, -0.05f); // Немного вперед от стены
                        textObj.transform.localRotation = Quaternion.identity;
                        textObj.transform.localScale = new Vector3(0.1f, 0.1f, 0.1f); // Увеличенный размер

                        // Добавляем компонент TextMesh для отображения текста в 3D-пространстве
                        TextMesh textMesh = textObj.AddComponent<TextMesh>();
                        textMesh.text = $"СТЕНА #{wall.id}";
                        textMesh.fontSize = 100; // Очень большой размер шрифта
                        textMesh.alignment = TextAlignment.Center;
                        textMesh.anchor = TextAnchor.MiddleCenter;
                        textMesh.color = Color.white;

                        // Создаем контур текста для лучшей видимости на любом фоне
                        textMesh.characterSize = 0.1f;
                        textMesh.offsetZ = -0.01f; // Немного смещаем вперед

                        // Добавляем светящийся материал
                        Renderer textRenderer = textObj.GetComponent<Renderer>();
                        if (textRenderer != null)
                        {
                              Material textMaterial = null;
                              try
                              {
                                    // Пытаемся найти шейдеры в порядке предпочтения
                                    Shader textShader = Shader.Find("GUI/Text Shader");
                                    if (textShader == null) textShader = Shader.Find("Standard");
                                    if (textShader == null) textShader = Shader.Find("Diffuse");
                                    if (textShader == null) textShader = Shader.Find("Sprites/Default");
                                    if (textShader == null) textShader = Shader.Find("Hidden/Internal-Colored");

                                    if (textShader != null)
                                    {
                                          textMaterial = new Material(textShader);
                                    }
                                    else
                                    {
                                          // Используем базовый материал, если не найден ни один шейдер
                                          Debug.LogWarning("Не удалось найти подходящий шейдер для текста стены. Используем материал по умолчанию.");
                                          textMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                                    }
                              }
                              catch (System.Exception ex)
                              {
                                    Debug.LogWarning($"Ошибка при создании материала для текста: {ex.Message}");
                                    // Крайний случай - создаем стандартный материал
                                    textMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                              }

                              if (textMaterial != null)
                              {
                                    textMaterial.color = Color.white;
                                    textRenderer.material = textMaterial;
                              }
                        }

                        // Добавляем компонент для поворота к камере
                        textObj.AddComponent<Billboard>();
                  }
                  catch (System.Exception ex)
                  {
                        Debug.LogWarning($"Ошибка при создании индикатора номера стены: {ex.Message}");
                  }
            }

            // Метод для добавления ярких маркеров углов
            private void AddBrightCornerMarkers(Transform parentTransform, float width, float height)
            {
                  try
                  {
                        // Создаем маркеры для четырех углов
                        float hw = width * 0.5f;
                        float hh = height * 0.5f;

                        // Создаем яркие шары в углах
                        GameObject sphere1 = GameObject.CreatePrimitive(PrimitiveType.Sphere);
                        sphere1.name = "CornerSphere1";
                        sphere1.transform.SetParent(parentTransform);
                        sphere1.transform.localPosition = new Vector3(-hw, -hh, 0.03f); // нижний левый
                        sphere1.transform.localScale = new Vector3(0.08f, 0.08f, 0.08f); // Заметный размер

                        GameObject sphere2 = GameObject.CreatePrimitive(PrimitiveType.Sphere);
                        sphere2.name = "CornerSphere2";
                        sphere2.transform.SetParent(parentTransform);
                        sphere2.transform.localPosition = new Vector3(hw, -hh, 0.03f); // нижний правый
                        sphere2.transform.localScale = new Vector3(0.08f, 0.08f, 0.08f);

                        GameObject sphere3 = GameObject.CreatePrimitive(PrimitiveType.Sphere);
                        sphere3.name = "CornerSphere3";
                        sphere3.transform.SetParent(parentTransform);
                        sphere3.transform.localPosition = new Vector3(hw, hh, 0.03f); // верхний правый
                        sphere3.transform.localScale = new Vector3(0.08f, 0.08f, 0.08f);

                        GameObject sphere4 = GameObject.CreatePrimitive(PrimitiveType.Sphere);
                        sphere4.name = "CornerSphere4";
                        sphere4.transform.SetParent(parentTransform);
                        sphere4.transform.localPosition = new Vector3(-hw, hh, 0.03f); // верхний левый
                        sphere4.transform.localScale = new Vector3(0.08f, 0.08f, 0.08f);

                        // Настраиваем материалы для шаров
                        Material sphereMaterial = null;
                        try
                        {
                              Shader sphereShader = Shader.Find("Standard");
                              if (sphereShader == null) sphereShader = Shader.Find("Diffuse");
                              if (sphereShader == null) sphereShader = Shader.Find("Sprites/Default");
                              if (sphereShader == null) sphereShader = Shader.Find("Hidden/Internal-Colored");

                              if (sphereShader != null)
                              {
                                    sphereMaterial = new Material(sphereShader);
                                    sphereMaterial.color = Color.red;

                                    // Включаем свечение, если шейдер поддерживает эмиссию
                                    if (sphereShader.name == "Standard")
                                    {
                                          sphereMaterial.EnableKeyword("_EMISSION");
                                          sphereMaterial.SetColor("_EmissionColor", Color.red * 2f); // Интенсивное свечение
                                    }
                              }
                              else
                              {
                                    // Используем базовый материал, если не найден ни один шейдер
                                    sphereMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                                    sphereMaterial.color = Color.red;
                              }
                        }
                        catch (System.Exception ex)
                        {
                              Debug.LogWarning($"Не удалось создать материал для маркера угла: {ex.Message}");
                              // Создаем просто красный материал
                              sphereMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                              sphereMaterial.color = Color.red;
                        }

                        if (sphereMaterial != null)
                        {
                              // Применяем материал к каждому шару
                              if (sphere1) sphere1.GetComponent<Renderer>().material = sphereMaterial;
                              if (sphere2) sphere2.GetComponent<Renderer>().material = sphereMaterial;
                              if (sphere3) sphere3.GetComponent<Renderer>().material = sphereMaterial;
                              if (sphere4) sphere4.GetComponent<Renderer>().material = sphereMaterial;
                        }

                        // Удаляем коллайдеры, так как они не нужны
                        if (sphere1) Destroy(sphere1.GetComponent<SphereCollider>());
                        if (sphere2) Destroy(sphere2.GetComponent<SphereCollider>());
                        if (sphere3) Destroy(sphere3.GetComponent<SphereCollider>());
                        if (sphere4) Destroy(sphere4.GetComponent<SphereCollider>());
                  }
                  catch (System.Exception ex)
                  {
                        Debug.LogWarning($"Ошибка при создании маркеров угла: {ex.Message}");
                  }
            }

            // Метод для добавления индикатора направления нормали стены
            private void AddWallNormalIndicator(Transform parentTransform)
            {
                  GameObject arrow = new GameObject("NormalArrow");
                  arrow.transform.SetParent(parentTransform);
                  arrow.transform.localPosition = new Vector3(0, 0, -0.1f); // Перед стеной
                  arrow.transform.localRotation = Quaternion.identity;

                  // Создаем стрелку с помощью LineRenderer
                  LineRenderer lineRenderer = arrow.AddComponent<LineRenderer>();
                  lineRenderer.useWorldSpace = false;
                  lineRenderer.startWidth = 0.03f;
                  lineRenderer.endWidth = 0.0f; // Сужающийся конец
                  lineRenderer.positionCount = 2;

                  // Устанавливаем позиции стрелки
                  lineRenderer.SetPosition(0, Vector3.zero); // Начало в центре стены
                  lineRenderer.SetPosition(1, new Vector3(0, 0, -0.2f)); // Стрелка указывает вперед от стены

                  // Создаем материал стрелки с защитой от null
                  Material arrowMaterial;
                  try
                  {
                        Shader arrowShader = Shader.Find("Particles/Additive");
                        if (arrowShader == null) arrowShader = Shader.Find("Sprites/Default");
                        if (arrowShader == null) arrowShader = Shader.Find("Standard");
                        if (arrowShader == null) arrowShader = Shader.Find("Hidden/Internal-Colored");

                        if (arrowShader != null)
                        {
                              arrowMaterial = new Material(arrowShader);
                        }
                        else
                        {
                              arrowMaterial = new Material(Resources.GetBuiltinResource<Material>("Default-Material.mat"));
                        }

                        arrowMaterial.color = Color.magenta;
                        lineRenderer.material = arrowMaterial;
                  }
                  catch (System.Exception ex)
                  {
                        Debug.LogWarning($"Не удалось создать материал для индикатора нормали: {ex.Message}");
                  }
            }

            // Метод для добавления индикатора типа поверхности
            private void AddSurfaceTypeIndicator(Transform parentTransform, bool isVirtual, float width, float height)
            {
                  // Просто заглушка, чтобы исправить ошибку компиляции
                  return;
            }

            // Метод для конвертации цвета в hex строку
            private string ColorToHex(Color color)
            {
                  return ColorUtility.ToHtmlStringRGB(color);
            }

            // Метод для покраски всех стен
            private void PaintAllWalls()
            {
                  Debug.Log("Painting all walls with color: " + ColorToHex(currentPaintColor));

                  // Красим все маркеры стен
                  foreach (var marker in wallMarkers)
                  {
                        if (marker != null)
                        {
                              var renderer = marker.GetComponent<Renderer>();
                              if (renderer != null)
                              {
                                    renderer.material.color = currentPaintColor;
                              }
                        }
                  }

                  ShowMessage("Все стены окрашены в выбранный цвет", 2.0f);
            }

            // Метод для настройки расширенного обнаружения стен
            private void ConfigureAdvancedWallDetection()
            {
                  if (wallDetector == null)
                  {
                        Debug.LogError("WallDetector не назначен, невозможно настроить расширенное обнаружение стен");
                        return;
                  }

                  // Проверяем активность компонента WallDetector
                  if (!wallDetector.gameObject.activeInHierarchy)
                  {
                        Debug.LogWarning("Компонент WallDetector отключен! Включаем...");
                        wallDetector.gameObject.SetActive(true);
                  }

                  if (!wallDetector.enabled)
                  {
                        Debug.LogWarning("Компонент WallDetector отключен! Включаем...");
                        wallDetector.enabled = true;
                  }

                  Debug.Log("Настроено расширенное обнаружение стен.");
            }

            // Метод для создания цветовой палитры
            private void CreateColorPalette()
            {
                  // Create color palette panel if container is assigned
                  if (colorPaletteContainer == null)
                  {
                        // Убедимся, что Canvas существует
                        Canvas canvas = EnsureCanvasExists();

                        // Create a container if one doesn't exist
                        GameObject container = new GameObject("ColorPaletteContainer");
                        colorPaletteContainer = container.transform;

                        // Привязываем к Canvas
                        if (canvas != null)
                        {
                              container.transform.SetParent(canvas.transform, false);
                        }
                        else
                        {
                              container.transform.SetParent(transform);
                        }

                        Debug.Log("Created color palette container dynamically");
                  }

                  // Create main panel
                  colorPalettePanel = new GameObject("ColorPalette");
                  colorPalettePanel.transform.SetParent(colorPaletteContainer, false);

                  // Add panel background
                  RectTransform rectTransform = colorPalettePanel.AddComponent<RectTransform>();
                  Image panelImage = colorPalettePanel.AddComponent<Image>();
                  panelImage.color = new Color(0.1f, 0.1f, 0.1f, 0.8f);

                  // Configure panel layout
                  rectTransform.anchorMin = new Vector2(0, 0);
                  rectTransform.anchorMax = new Vector2(1, 1);
                  rectTransform.offsetMin = Vector2.zero;
                  rectTransform.offsetMax = Vector2.zero;

                  // По умолчанию палитра скрыта
                  colorPalettePanel.SetActive(false);
            }

            // Метод для создания кнопки покраски всех стен
            private void CreatePaintAllButton()
            {
                  Canvas canvas = EnsureCanvasExists();
                  if (canvas == null) return;

                  // Проверяем, нет ли уже такой кнопки
                  if (GameObject.Find("PaintAllButton") != null) return;

                  // Создаем объект кнопки
                  GameObject buttonObj = new GameObject("PaintAllButton");
                  buttonObj.transform.SetParent(canvas.transform, false);

                  // Настраиваем RectTransform
                  RectTransform rectTransform = buttonObj.AddComponent<RectTransform>();
                  rectTransform.anchorMin = new Vector2(0.5f, 0);
                  rectTransform.anchorMax = new Vector2(0.5f, 0);
                  rectTransform.pivot = new Vector2(0.5f, 0);
                  rectTransform.sizeDelta = new Vector2(200, 60);
                  rectTransform.anchoredPosition = new Vector2(0, 20);

                  // Добавляем изображение для кнопки
                  Image buttonImage = buttonObj.AddComponent<Image>();
                  buttonImage.color = new Color(0.2f, 0.6f, 1.0f, 0.8f);

                  // Добавляем компонент кнопки
                  Button button = buttonObj.AddComponent<Button>();
                  button.colors = button.colors;

                  // Добавляем текст на кнопку
                  GameObject textObj = new GameObject("Text");
                  textObj.transform.SetParent(buttonObj.transform, false);

                  // Настраиваем RectTransform для текста
                  RectTransform textRectTransform = textObj.AddComponent<RectTransform>();
                  textRectTransform.anchorMin = Vector2.zero;
                  textRectTransform.anchorMax = Vector2.one;
                  textRectTransform.offsetMin = Vector2.zero;
                  textRectTransform.offsetMax = Vector2.zero;

                  // Добавляем компонент текста
                  Text text = textObj.AddComponent<Text>();
                  text.text = "ЗАКРАСИТЬ ВСЕ СТЕНЫ";
                  text.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
                  text.fontSize = 20;
                  text.alignment = TextAnchor.MiddleCenter;
                  text.color = Color.white;
                  text.fontStyle = FontStyle.Bold;

                  // Добавляем обработчик события клика
                  button.onClick.AddListener(PaintAllWalls);

                  Debug.Log("Создана кнопка для быстрой покраски всех стен");
            }

            // Корутина для улучшения видимости объектов после инициализации
            private IEnumerator DelayedEnsureVisibility()
            {
                  // Ждем немного, чтобы все объекты успели инициализироваться
                  yield return new WaitForSeconds(1.5f);

                  // Делаем камеру полупрозрачной для лучшей видимости 3D объектов
                  if (cameraPreview != null)
                  {
                        cameraPreview.color = new Color(1f, 1f, 1f, 0.7f);
                        Debug.Log("Настроена прозрачность камеры для лучшей видимости 3D объектов");
                  }

                  // Убедимся, что маркеры стен видимы
                  UpdateWallMarkersVisibility(true);
            }
      }
}


